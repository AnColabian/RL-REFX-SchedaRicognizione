                                    <Label text="{i18n>lblStfini}"/>
                                    <Input id="inputStfini" value="{scheme>/0/stfini}" width="100%"/>
                                    <Label text="{i18n>lblStimpi}"/>
                                    <Input id="inputStimpi" value="{scheme>/0/stimpi}" width="100%"/>
                                    <Label text="{i18n>lblStnote}"/>

                                    <Label text="{i18n>lblCoogis}"/>
                                    <Input id="inputCoogis" value="{scheme>/0/coogis}" width="100%"/>
                                    <Label text="{i18n>lblFabter}"/>
                                    <Select id="selectFabter" items="{path: 'scheme>/0/fabter'}" width="100%">
                                        <core:Item key="01" text="Edificato"/>
                                        <core:Item key="02" text="Non Edificato"/>
                                    </Select>
                                    <Label text="{i18n>lblUsofab}"/>
                                    <Input id="inputUsofab" value="{scheme>/0/usofab}" width="100%"/>
                                    <Label text="{i18n>lblUsoter}"/>
                                    <Input id="inputUsoter" value="{scheme>/0/usoter}" width="100%"/>
                                    <Label text="{i18n>lblSuplut}"/>
                                    <Input id="inputSuplut" value="{scheme>/0/suplut}" type="Number" width="100%"/>
                                    <Label text="{i18n>lblSupfon}"/>
                                    <Input id="inputSupfon" value="{scheme>/0/supfon}" type="Number" width="100%"/>
                                    <Label text="{i18n>lblAccess}"/>
                                    <Input id="inputAccess" value="{scheme>/0/access}" width="100%"/>
                                    <Label text="{i18n>lblPorzed}"/>
                                    <Input id="inputPorzed" value="{scheme>/0/porzed}" width="100%"/>
                                    <Label text="{i18n>lblNumedi}"/>
                                    <Input id="inputNumedi" value="{scheme>/0/numedi}" type="Number" width="100%"/>
                                    <Label text="{i18n>lblNumfuo}"/>
                                    <Input id="inputNumfuo" value="{scheme>/0/numfuo}" type="Number" width="100%"/>
                                    <Label text="{i18n>lblNument}"/>
                                    <Input id="inputNument" value="{scheme>/0/nument}" type="Number" width="100%"/>
                                    <Label text="{i18n>lblColleg}"/>
                                    <Input id="inputColleg" value="{scheme>/0/colleg}" width="100%"/>
                                    <Label text="{i18n>lblStport}"/>

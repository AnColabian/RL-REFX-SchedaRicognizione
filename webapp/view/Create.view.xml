<mvc:View controllerName="schedaricognizione.controller.Create"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="pageCreate" title="{i18n>appTitle}" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <ScrollContainer vertical="true" horizontal="false" focusable="false">
                <VBox class="sapUiMediumMargin">
                    <Panel id="panelIdenti" expandable="true" expanded="true" headerText="{i18n>sectionIdenti}" class="sapUiSmallMarginBottom">
                        <content>
                            <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                                <f:content>
                                    <Label text="{i18n>lblIdScheda}"/>
                                    <Text text="{scheme>/0/idscheda}"/>
                                    <Label text="{i18n>lblStato}"/>
                                    <Text text="{scheme>/0/stato}"/>
                                    <Label text="{i18n>lblIdSchedaModello}"/>
                                    <Input id="inputIdSchedaModello" value="{scheme>/0/idsc_mdl}" width="100%"/>
                                    <Label text="{i18n>lblDtcomp}"/>
                                    <Text text="{scheme>/0/dtcomp}"/>
                                </f:content>
                            </f:SimpleForm>
                        </content>
                    </Panel>
                    <Panel id="panelOA" expandable="true" expanded="true" headerText="{i18n>sectionOA}" class="sapUiSmallMarginBottom">
                        <content>
                            <VBox class="sapUiSmallMargin">
                                <HBox class="sapUiSmallMarginBottom" justifyContent="SpaceBetween">
                                    <VBox>
                                        <Label text="{i18n>lblSwenr}"/>
                                        <Input id="inputSwenr" value="" width="200px" placeholder="UE"/>
                                    </VBox>
                                    <VBox>
                                        <Label text="{i18n>lblSgrnr}"/>
                                        <Input id="inputSgrnr" value="" width="200px" placeholder="Terreno"/>
                                    </VBox>
                                    <VBox>
                                        <Label text="{i18n>lblSgenr}"/>
                                        <Input id="inputSgenr" value="" width="200px" placeholder="Edificio"/>
                                    </VBox>
                                </HBox>
                                <HBox class="sapUiSmallMarginBottom">
                                    <Button id="btnSearchOA" text="{i18n>btnSearch}" type="Default" press=".onSearchOA" width="150px"/>
                                </HBox>
                                <Table id="tableOA" items="{oa>/}" mode="MultiSelect" class="sapUiSmallMarginTop">
                                    <columns>
                                        <Column width="3rem">
                                            <header>
                                                <Text text="Sel."/>
                                            </header>
                                        </Column>
                                        <Column>
                                            <header>
                                                <Text text="{i18n>lblBukrs}"/>
                                            </header>
                                        </Column>
                                        <Column>
                                            <header>
                                                <Text text="{i18n>lblSwenr}"/>
                                            </header>
                                        </Column>
                                        <Column>
                                            <header>
                                                <Text text="{i18n>lblSgrnr}"/>
                                            </header>
                                        </Column>
                                        <Column>
                                            <header>
                                                <Text text="{i18n>lblSgenr}"/>
                                            </header>
                                        </Column>
                                        <Column>
                                            <header>
                                                <Text text="{i18n>lblAoid}"/>
                                            </header>
                                        </Column>
                                        <Column>
                                            <header>
                                                <Text text="{i18n>lblZztpca}"/>
                                            </header>
                                        </Column>
                                        <Column>
                                            <header>
                                                <Text text="{i18n>lblZzfogl}"/>
                                            </header>
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <CheckBox selected="false"/>
                                                <Text text="{oa>bukrs}"/>
                                                <Text text="{oa>swenr}"/>
                                                <Text text="{oa>sgrnr}"/>
                                                <Text text="{oa>sgenr}"/>
                                                <Text text="{oa>aoid}"/>
                                                <Text text="{oa>zztpca}"/>
                                                <Text text="{oa>zzfogl}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                                <HBox class="sapUiSmallMarginTop" justifyContent="SpaceBetween">
                                    <HBox spacing="0.5rem">
                                        <Button id="btnSelectAll" text="{i18n>btnSelectAll}" type="Default" press=".onSelectAllOA" width="120px"/>
                                        <Button id="btnDeselectAll" text="{i18n>btnDeselectAll}" type="Default" press=".onDeselectAllOA" width="140px"/>
                                        <Button id="btnRemoveOA" text="{i18n>btnRemove}" type="Reject" press=".onRemoveOA" width="140px"/>
                                    </HBox>
                                </HBox>
                            </VBox>
                        </content>
                    </Panel>
                    <Panel id="panelTestata" expandable="true" expanded="true" headerText="{i18n>sectionTestata}" class="sapUiSmallMarginBottom">
                        <content>
                            <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                                <f:content>
                                    <Label text="{i18n>lblDocval}"/>
                                    <Input id="inputDocval" value="{scheme>/0/docval}" width="100%"/>
                                    <Label text="{i18n>lblIdbene}"/>
                                    <Input id="inputIdbene" value="{scheme>/0/idbene}" width="100%"/>
                                    <Label text="{i18n>lblEnteprop}"/>
                                    <Input id="inputEntepr" value="{scheme>/0/entepr}" width="100%"/>
                                    <Label text="{i18n>lblTxbene}"/>

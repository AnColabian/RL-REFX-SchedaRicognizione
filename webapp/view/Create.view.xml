                                    <Label text="{i18n>lblEspgar}"/>
                                    <Input id="inputEspgar" value="{scheme>/0/espgar}" width="100%"/>
                                    <Label text="{i18n>lblEsitoa}"/>
                                    <Input id="inputEsitoa" value="{scheme>/0/esitoa}" width="100%"/>
                                </f:content>
                            </f:SimpleForm>
                        </content>
                    </Panel>
                </VBox>
            </ScrollContainer>
        </content>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button id="btnSave" text="{i18n>btnSave}" type="Emphasized" press=".onSave"/>
                <Button id="btnCancel" text="{i18n>btnCancel}" type="Default" press=".onCancel"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
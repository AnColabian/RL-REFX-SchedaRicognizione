                                    <Label text="{i18n>lblFinitu}"/>
                                    <Input id="inputFinitu" value="{scheme>/0/finitu}" width="100%"/>
                                    <Label text="{i18n>lblImpian}"/>
                                    <Input id="inputImpian" value="{scheme>/0/impian}" width="100%"/>
                                    <Label text="{i18n>lblPertin}"/>
                                    <Input id="inputPertin" value="{scheme>/0/pertin}" width="100%"/>
                                    <Label text="{i18n>lblSupcop}"/>
                                    <Input id="inputSupcop" value="{scheme>/0/supcop}" type="Number" width="100%"/>
                                    <Label text="{i18n>lblSupsco}"/>
                                    <Input id="inputSupsco" value="{scheme>/0/supsco}" type="Number" width="100%"/>
                                    <Label text="{i18n>lblZonomi}"/>
                                    <Input id="inputZonomi" value="{scheme>/0/zonomi}" width="100%"/>
                                    <Label text="{i18n>lblApe}"/>
                                    <Select id="selectApe" selectedKey="{scheme>/0/ape}" width="100%">
                                        <core:Item key="SI" text="Sì"/>
                                        <core:Item key="NO" text="No"/>
                                    </Select>
                                    <Label text="{i18n>lblClsene}"/>
                                    <Input id="inputClsene" value="{scheme>/0/clsene}" width="100%"/>
                                    <Label text="{i18n>lblTitolo}"/>
                                    <Input id="inputTitolo" value="{scheme>/0/titolo}" width="100%"/>
                                    <Label text="{i18n>lblAnnopr}"/>
                                    <Input id="inputAnnopr" value="{scheme>/0/annopr}" type="Number" width="100%"/>
                                    <Label text="{i18n>lblLimiti}"/>
                                    <Input id="inputLimiti" value="{scheme>/0/limiti}" width="100%"/>
                                    <Label text="{i18n>lblAnnocs}"/>
                                    <Input id="inputAnnocs" value="{scheme>/0/annocs}" type="Number" width="100%"/>
                                    <Label text="{i18n>lblStgene}"/>
                                    <Input id="inputStgene" value="{scheme>/0/stgene}" width="100%"/>
                                    <Label text="{i18n>lblStspor}"/>
                                    <Input id="inputStspor" value="{scheme>/0/stspor}" width="100%"/>
                                    <Label text="{i18n>lblStcope}"/>

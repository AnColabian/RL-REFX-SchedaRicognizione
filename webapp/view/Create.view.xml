                                    <Label text="{i18n>lblDsturb}"/>
                                    <Input id="inputDsturb" value="{scheme>/0/dsturb}" width="100%"/>
                                    <Label text="{i18n>lblIterur}"/>
                                    <Input id="inputIterur" value="{scheme>/0/iterur}" width="100%"/>
                                    <Label text="{i18n>lblTitori}"/>
                                    <Select id="selectTitori" selectedKey="{scheme>/0/titori}" width="100%">
                                        <core:Item key="SI" text="Sì"/>
                                        <core:Item key="NO" text="No"/>
                                    </Select>
                                    <Label text="{i18n>lblAnte67}"/>
                                    <Select id="selectAnte67" selectedKey="{scheme>/0/ante67}" width="100%">
                                        <core:Item key="SI" text="Sì"/>
                                        <core:Item key="NO" text="No"/>
                                    </Select>
                                    <Label text="{i18n>lblAnte42}"/>
                                    <Select id="selectAnte42" selectedKey="{scheme>/0/ante42}" width="100%">
                                        <core:Item key="SI" text="Sì"/>
                                        <core:Item key="NO" text="No"/>
                                    </Select>
                                    <Label text="{i18n>lblCorcat}"/>
                                    <Select id="selectCorcat" selectedKey="{scheme>/0/corcat}" width="100%">
                                        <core:Item key="SI" text="Sì"/>
                                        <core:Item key="NO" text="No"/>
                                    </Select>
                                    <Label text="{i18n>lblCeragi}"/>
                                    <Input id="inputCeragi" value="{scheme>/0/ceragi}" width="100%"/>
                                    <Label text="{i18n>lblCollst}"/>
                                    <Input id="inputCollst" value="{scheme>/0/collst}" width="100%"/>
                                    <Label text="{i18n>lblDocamb}"/>
                                    <Input id="inputDocamb" value="{scheme>/0/docamb}" width="100%"/>
                                    <Label text="{i18n>lblVulssm}"/>
                                    <Select id="selectVulssm" selectedKey="{scheme>/0/vulssm}" width="100%">
                                        <core:Item key="00" text="No"/>
                                        <core:Item key="01" text="Sì"/>
                                    </Select>
                                    <Label text="{i18n>lblVulamb}"/>
                                    <Select id="selectVulamb" selectedKey="{scheme>/0/vulamb}" width="100%">
                                        <core:Item key="00" text="No"/>
                                        <core:Item key="01" text="Sì"/>
                                    </Select>
                                    <Label text="{i18n>lblStimav}"/>
                                    <Input id="inputStimav" value="{scheme>/0/stimav}" type="Number" width="100%"/>
                                    <Label text="{i18n>lblStimnt}"/>
                                    <Input id="inputStimnt" value="{scheme>/0/stimnt}" width="100%"/>
                                    <Label text="{i18n>lblAnnovl}"/>
                                    <Input id="inputAnnovl" value="{scheme>/0/annovl}" type="Number" width="100%"/>
                                    <Label text="{i18n>lblCanloc}"/>
                                    <Input id="inputCanloc" value="{scheme>/0/canloc}" width="100%"/>
                                    <Label text="{i18n>lblPrgprc}"/>
                                    <Input id="inputPrgprc" value="{scheme>/0/prgprc}" width="100%"/>
                                    <Label text="{i18n>lblDelibe}"/>

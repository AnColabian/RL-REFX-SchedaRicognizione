<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <Dialog id="dialogImportTemplate" title="Nuova Scheda Ricognizione" contentWidth="32rem" initialFocus="comboTemplateScheme">
        <content>
            <VBox class="sapUiSmallMargin">
                <Text text="Seleziona una Scheda Modello da importare oppure procedi con una nuova scheda senza modello."/>
                <Label text="ID Scheda Modello" labelFor="comboTemplateScheme" class="sapUiSmallMarginTop"/>
                <Input id="comboTemplateScheme" value="{templateSelection>/text}" width="100%" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onTemplateValueHelp"/>
            </VBox>
        </content>
        <beginButton>
            <Button id="btnImportTemplate" text="Importa" type="Emphasized" enabled="{= !!${templateSelection>/idScheda} }" press=".onImportTemplate"/>
        </beginButton>
        <endButton>
            <Button id="btnCreateWithoutTemplate" text="Crea Nuova" press=".onCreateWithoutTemplate"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
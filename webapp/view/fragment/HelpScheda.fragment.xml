<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <TableSelectDialog id="dialogHelpScheda" title="Seleziona Scheda Ricognizione" contentWidth="80rem" multiSelect="false" rememberSelections="false" items="{display>/helpScheda}" search=".onSearchHelpScheda" liveChange=".onSearchHelpScheda" confirm=".onConfirmHelpScheda">
        <columns>
            <Column>
                <header>
                    <Text text="ID Scheda"/>
                </header>
            </Column>
            <Column>
                <header>
                    <Text text="Stato"/>
                </header>
            </Column>
            <Column>
                <header>
                    <Text text="Doc. Valorizzazione"/>
                </header>
            </Column>
            <Column>
                <header>
                    <Text text="ID Bene"/>
                </header>
            </Column>
            <Column>
                <header>
                    <Text text="Denominazione Bene"/>
                </header>
            </Column>
            <Column>
                <header>
                    <Text text="Autore"/>
                </header>
            </Column>
            <Column>
                <header>
                    <Text text="Data Creazione"/>
                </header>
            </Column>
        </columns>
        <items>
            <ColumnListItem>
                <cells>
                    <Text text="{display>idScheda}"/>
                    <Text text="{path: 'display>stato', formatter: '.formatter.formatSchedaState'}"/>
                    <Text text="{path: 'display>docVal', formatter: '.formatter.formatDisplayValue'}"/>
                    <Text text="{path: 'display>idBene', formatter: '.formatter.formatDisplayValue'}"/>
                    <Text text="{path: 'display>denBene', formatter: '.formatter.formatDisplayValue'}"/>
                    <Text text="{display>autore}"/>
                    <Text text="{path: 'display>dtCre', formatter: '.formatter.formatDate'}"/>
                </cells>
            </ColumnListItem>
        </items>
    </TableSelectDialog>
</core:FragmentDefinition>
                                        <t:Column width="10rem">
                                            <Label text="{i18n>lblCodComCat}"/>
                                            <t:template>
                                                <Text text="{edit>codComCat}"/>
                                            </t:template>
                                        </t:Column>
                                    </t:columns>
                                </t:Table>
                            </VBox>
                        </content>
                    </Panel>
                </VBox>
            </ScrollContainer>
        </content>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button id="btnSaveDraft" text="{i18n>btnSaveDraft}" type="Emphasized" press=".onSaveDraft"/>
                <Button id="btnSaveFinal" text="{i18n>btnSaveFinal}" type="Default" press=".onSaveFinal"/>
                <Button id="btnCancel" text="{i18n>btnCancel}" type="Default" press=".onCancel"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
